#!/bin/sh
### BEGIN INIT INFO
# Provides:          attendance-web
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     3 4 5
# Default-Stop:      0 1 2 6
# Short-Description: Face attendance read-only web UI
### END INIT INFO

APP=/usr/bin/attendance-web
PIDFILE=/run/attendance-web.pid
CONF=/etc/attendance-web.conf

case "$1" in
  start)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "attendance-web already running"
        exit 0
    fi
    if [ ! -r "$CONF" ]; then
        echo "attendance-web: missing $CONF"
        exit 1
    fi
    mkdir -p /run
    "$APP" --config "$CONF" >/var/log/attendance-web.log 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "attendance-web started"
    else
        rm -f "$PIDFILE"
        echo "attendance-web failed; see /var/log/attendance-web.log"
        exit 1
    fi
    ;;
  stop)
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "attendance-web running (pid $(cat "$PIDFILE"))"
    else
        echo "attendance-web not running"
        exit 1
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 2
    ;;
esac
exit 0
